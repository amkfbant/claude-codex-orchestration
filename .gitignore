# BEGIN claude-codex-orchestration
.orchestration/cache/**
!.orchestration/cache/.gitkeep
.orchestration/locks/**
!.orchestration/locks/.gitkeep
# Ignore all task runtime artifacts; keep only spec history
.orchestration/tasks/*/**
!.orchestration/tasks/*/spec.md
!.orchestration/tasks/*/spec.v*.md
.orchestration/session-*.json
.orchestration/session-*.jsonl
.orchestration/session-*.txt
.orchestration/init-detect.json
.orchestration/audit.jsonl
.orchestration/manager.lock
.orchestration/ledger.json.backup.*
*.tmp
.codex/config.local.toml
.codex/auth.json
.codex/sessions/
.codex/log/
.codex/tmp/
.claude/settings.local.json
# END claude-codex-orchestration

# macOS / filesystem metadata
.DS_Store
.AppleDouble
.LSOverride
Icon?
._*

# Editor and local tooling state
.idea/
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json
*.swp
*.swo
*~

# Local environment and secrets
.env
.env.*
!.env.example
secrets/
*.pem
*.key
*.p12
*.pfx

# Logs and temporary files
*.log
logs/
tmp/
temp/

# Python local bytecode from validation or setup checks
__pycache__/
*.py[cod]
.python-version
.venv/
venv/
env/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
coverage.xml
htmlcov/

# Node/package-manager artifacts for projects using this kit locally
node_modules/
.npm/
.pnpm-store/
.yarn/cache/
.yarn/unplugged/
.yarn/install-state.gz

# Build and coverage outputs
dist/
build/
coverage/